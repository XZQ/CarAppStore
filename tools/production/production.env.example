# Copy this file to production.env in the same directory.
# production.env is ignored by Git. Never commit real credentials or keystores.

CARAPPSTORE_CATALOG_PROD_URL=https://catalog.your-company.com/carappstore/catalog.json
CARAPPSTORE_DOWNLOAD_PROD_BASE_URL=https://downloads.your-company.com/carappstore

CARAPPSTORE_CATALOG_AUTH_HEADER=Authorization
CARAPPSTORE_CATALOG_AUTH_VALUE=

# HEADER sends a fixed header on every CDN HEAD/GET/Range request.
# SIGNED_URL requires the catalog to return short-lived signed HTTPS APK URLs.
CARAPPSTORE_DOWNLOAD_AUTH_MODE=SIGNED_URL
CARAPPSTORE_DOWNLOAD_AUTH_HEADER=
CARAPPSTORE_DOWNLOAD_AUTH_VALUE=

CARAPPSTORE_RELEASE_STORE_FILE=C:\secure\carappstore-release.p12
CARAPPSTORE_RELEASE_STORE_PASSWORD=
CARAPPSTORE_RELEASE_KEY_ALIAS=carappstore
CARAPPSTORE_RELEASE_KEY_PASSWORD=
