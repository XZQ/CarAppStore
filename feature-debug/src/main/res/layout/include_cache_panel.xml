<?xml version="1.0" encoding="utf-8"?>
<!-- 缓存管理面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_14dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="@dimen/spacing_18dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_debug_cache_management"
        android:textColor="@color/car_text_primary"
        android:textSize="@dimen/text_xl"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnClearCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_primary_button_warning"
        android:layout_marginTop="@dimen/spacing_14dp"
        android:text="@string/ui_debug_clear_cache"
        android:textAllCaps="false"
        android:textColor="@color/car_text_primary" />

    <TextView
        android:id="@+id/tvEventLogStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_14dp"
        android:background="@drawable/bg_card_alt"
        android:padding="@dimen/spacing_10dp"
        android:text="@string/ui_debug_event_log_status_empty"
        android:textColor="@color/car_text_secondary"
        android:textSize="@dimen/text_sm_13" />

    <Button
        android:id="@+id/btnClearEventLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10dp"
        android:background="@drawable/bg_secondary_button"
        android:text="@string/ui_debug_clear_event_log"
        android:textAllCaps="false"
        android:textColor="@color/car_text_primary" />
</LinearLayout>
