<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_activity"
    android:padding="@dimen/spacing_20dp">

    <LinearLayout
        android:id="@+id/navigationRail"
        android:layout_width="236dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="@dimen/spacing_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_carappstore"
            android:textColor="@color/car_text_primary"
            android:textSize="@dimen/text_3xl"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:text="@string/ui_service_center_subtitle"
            android:textColor="@color/car_text_secondary"
            android:textSize="@dimen/text_sm" />

        <Button android:id="@+id/btnNavHome" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_24dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_home" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavSearch" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_game" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavDownload" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_software" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavUpgrade" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_category" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavInstall" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_rank" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavEssential" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_essential" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavDebug" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_activity" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Button android:id="@+id/btnNavMyApps" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/spacing_10dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_my_apps" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/btnNavDesktopDownload" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/bg_nav_button" android:text="@string/ui_download_manager" android:textAllCaps="false" android:textColor="@color/car_text_primary" android:textSize="@dimen/text_md" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_20dp"
        android:layout_marginEnd="@dimen/spacing_20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/desktopSidePanel"
        app:layout_constraintStart_toEndOf="@id/navigationRail"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/desktopSidePanel"
        android:layout_width="260dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="@dimen/spacing_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDesktopSummaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_task_summary"
            android:textColor="@color/car_text_primary"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDesktopSummaryBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:text="@string/ui_task_center_header_hint"
            android:textColor="@color/car_text_secondary"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
