<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_18dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/spacing_12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/includeDetailAppInfo"
                layout="@layout/include_detail_app_info" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_18dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/spacing_12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/ui_download"
                android:textAllCaps="false"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <include
                android:id="@+id/includeDetailTaskStatus"
                layout="@layout/include_detail_task_status" />

            <Button
                android:id="@+id/btnGoMyApps"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/spacing_14dp"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/ui_my_apps"
                android:textAllCaps="false"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/spacing_10dp"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/ui_back_home"
                android:textAllCaps="false"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
