<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_hero"
            android:orientation="vertical"
            android:padding="@dimen/spacing_18dp">

            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&#x9752;&#x67e0;&#x5e94;&#x7528;&#x5546;&#x5e97;"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_3xl"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8dp"
                android:textColor="@color/car_text_secondary"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/tvPolicyPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12dp"
                android:background="@drawable/bg_home_chip"
                android:paddingStart="@dimen/spacing_14dp"
                android:paddingTop="@dimen/spacing_10dp"
                android:paddingEnd="@dimen/spacing_14dp"
                android:paddingBottom="@dimen/spacing_10dp"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_sm_13" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_chip_active"
                    android:paddingStart="@dimen/spacing_14dp"
                    android:paddingTop="@dimen/spacing_8dp"
                    android:paddingEnd="@dimen/spacing_14dp"
                    android:paddingBottom="@dimen/spacing_8dp"
                    android:text="&#x63a8;&#x8350;"
                    android:textColor="@color/car_bg"
                    android:textSize="@dimen/text_sm_13"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8dp"
                    android:background="@drawable/bg_home_chip"
                    android:paddingStart="@dimen/spacing_14dp"
                    android:paddingTop="@dimen/spacing_8dp"
                    android:paddingEnd="@dimen/spacing_14dp"
                    android:paddingBottom="@dimen/spacing_8dp"
                    android:text="&#x5f71;&#x97f3;"
                    android:textColor="@color/car_text_primary"
                    android:textSize="@dimen/text_sm_13" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8dp"
                    android:background="@drawable/bg_home_chip"
                    android:paddingStart="@dimen/spacing_14dp"
                    android:paddingTop="@dimen/spacing_8dp"
                    android:paddingEnd="@dimen/spacing_14dp"
                    android:paddingBottom="@dimen/spacing_8dp"
                    android:text="&#x51fa;&#x884c;"
                    android:textColor="@color/car_text_primary"
                    android:textSize="@dimen/text_sm_13" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14dp"
            android:background="@drawable/bg_card_alt"
            android:orientation="vertical"
            android:padding="@dimen/spacing_14dp">

            <TextView
                android:id="@+id/tvRecentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_home_recently_used"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecentApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6dp"
                android:textColor="@color/car_text_secondary"
                android:textSize="@dimen/text_sm_13" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSearchApps"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/spacing_6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/ui_search_apps"
                android:textAllCaps="false"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMyApps"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/spacing_6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:text="@string/ui_my_apps"
                android:textAllCaps="false"
                android:textColor="@color/car_text_primary"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
